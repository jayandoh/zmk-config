#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    behaviors {
        enc_scroll: enc_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <60>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3        &kp N4        &kp N5                          &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E         &kp R         &kp T                           &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BACKSLASH
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F         &kp G                           &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V         &kp B   &mkp MB4     &mkp MB5   &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                &kp LEFT_ALT  &kp LEFT_GUI  &mo 2   &kp SPACE    &kp SPACE  &mo 2   &mo 3   &to 1
            >;

            sensor-bindings =
                <&enc_scroll MOVE_Y(-30) MOVE_Y(30)>,
                <&enc_scroll MOVE_Y(-40) MOVE_Y(40)>;
        };

        alternative_layer {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3        &kp N4        &kp N5                          &kp N6         &kp N7  &kp N8     &kp N9   &kp N0    &to 0
&kp TAB         &kp Q   &kp W   &kp E         &kp R         &kp T                           &kp Y          &kp U   &kp I      &kp O    &kp P     &kp MINUS
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F         &kp G                           &kp H          &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V         &kp B   &mkp MB4     &mkp MB5   &kp N          &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp BACKSLASH
                                &kp LEFT_GUI  &kp LEFT_ALT  &mo 2   &kp ENTER    &kp SPACE  &kp BACKSPACE  &mo 2   &mo 3
            >;

            sensor-bindings =
                <&enc_scroll MOVE_Y(-30) MOVE_Y(30)>,
                <&enc_scroll MOVE_Y(-40) MOVE_Y(40)>;
        };

        esc+fn+nav {
            bindings = <
&kp ESCAPE  &kp F1  &kp F2    &kp F3          &kp F4     &kp F5                                       &kp F6         &kp F7    &kp F8    &kp F9     &kp F10          &kp F11
&trans      &trans  &kp HOME  &kp UP_ARROW    &kp END    &kp PAGE_UP                                  &kp PAGE_UP    &kp HOME  &kp UP    &kp END    &kp PRINTSCREEN  &kp F12
&trans      &trans  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp PAGE_DOWN                                &kp PAGE_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans           &trans
&trans      &trans  &trans    &trans          &trans     &trans         &kp LS(K_PREV)    &kp K_NEXT  &trans         &trans    &trans    &trans     &trans           &trans
                              &trans          &trans     &trans         &trans            &trans      &trans         &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        bt+overflow_keys {
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &kp MINUS         &kp EQUAL          &kp DELETE
&trans          &trans        &trans        &trans        &trans        &trans                          &kp N1  &kp N2  &kp N3  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp INSERT
&trans          &trans        &trans        &trans        &trans        &trans                          &kp N4  &kp N5  &kp N6  &trans            &kp APOS           &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans    &trans  &kp N7  &kp N8  &kp N9  &kp N0            &trans             &trans
                                            &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
